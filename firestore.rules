rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Vervang deze tekst door de UID van het organisatoraccount uit Firebase Authentication.
    function organizer() { return signedIn() && request.auth.uid == 'HkB2N5CJXZOtv9BIRoaCrV3Eh9k1'; }

    match /dinners/{dinnerId} {
      allow read: if signedIn();
      allow create, update, delete: if organizer();

      match /ratings/{ratingId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['dish', 'rater', 'score'])
          && request.resource.data.keys().hasAll(['dish', 'rater', 'score'])
          && request.resource.data.dish is int
          && request.resource.data.rater is int
          && request.resource.data.score is int
          && request.resource.data.dish >= 0 && request.resource.data.dish < 6
          && request.resource.data.rater >= 0 && request.resource.data.rater < 6
          && request.resource.data.dish != request.resource.data.rater
          && request.resource.data.score >= 1 && request.resource.data.score <= 10
          && ratingId == (string(request.resource.data.dish) + '_' + string(request.resource.data.rater));
        allow delete: if organizer();
      }
    }
  }
}
